# Sitio de Nginx para el servidor de archivos. Reemplazar DOMINIO por el nombre del servidor
# (por ejemplo archivos.miempresa.com) y guardar como /etc/nginx/sites-available/manuales.
# Los certificados los gestiona Certbot (ver README.md): al correrlo agrega solo las líneas de SSL.
server {
    listen 80;
    listen [::]:80;
    server_name DOMINIO;

    # Cabeceras de seguridad básicas
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    # El programa de archivos (Node, manejado por pm2)
    location /api/ {
        limit_req zone=manuales_api burst=40 nodelay;
        client_max_body_size 520m;
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_request_buffering off;   # las subidas grandes pasan directo, sin duplicarse en disco
        proxy_read_timeout 1800s;
        proxy_send_timeout 1800s;
    }

    # Los archivos en sí: solo se llega acá por una orden interna del programa
    # (nadie puede entrar directo a esta dirección).
    location /_archivos/ {
        internal;
        alias /srv/manuales/archivos/;
        add_header Content-Security-Policy "sandbox" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location / {
        default_type text/plain;
        return 200 "Servidor de archivos\n";
    }
}
