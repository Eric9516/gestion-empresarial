# Configuración del servidor de archivos. Se copia a /opt/manuales-api/.env (permisos 600,
# dueño: el usuario "manuales"). NUNCA se sube a Git.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=
# Secreto para firmar los links de descarga. Generarlo con:  openssl rand -hex 32
LINK_SECRET=
# Dirección pública de este servidor (sin barra final)
PUBLIC_BASE_URL=https://archivos.miempresa.com
# Direcciones de la app que pueden usar el servidor, separadas por coma
ALLOWED_ORIGINS=https://app.miempresa.com
PORT=3001
