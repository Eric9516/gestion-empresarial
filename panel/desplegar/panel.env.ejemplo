# Configuración del panel. Se copia a /etc/panel/panel.env en el servidor, con permisos 600 (solo root la puede leer).
# NUNCA se sube a Git ni se pega en un chat. Los valores marcados ← se generan con:  node scripts/generar-secretos.mjs

# Dirección EXACTA del panel (la que te da Tailscale). Sin barra final. Si cambia, hay que volver a registrar las llaves.
PANEL_ORIGEN=https://panel.TU-RED.ts.net

# Tu usuario de Tailscale (el correo con el que entrás). Cada pedido tiene que venir de ese usuario.
PANEL_USUARIO_RED=tu-correo@ejemplo.com

PANEL_SECRETO=←                  # 32+ caracteres
PANEL_CODIGO_ALTA=←              # 32+ caracteres; se usa una vez para registrar tu llave

# Llave de Supabase de la cuenta del panel (ver docs/PANEL-INSTALACION.md, pasos 1 y 2)
SUPABASE_ACCESS_TOKEN=sbp_...
# (Opcional) Organizaciones de clientes fijas en el servidor (identificadores separados por coma). Las demás se agregan desde el panel (Organizaciones → Agregar) y no hace falta tocar este archivo.
# PANEL_ORG_SLUGS=identificador1,identificador2

# Base del panel (en este mismo servidor). Usuario panel_app: solo puede ejecutar las funciones del panel.
PANEL_DB_URL=postgres://panel_app:←@127.0.0.1:5432/panel

# Avisos al celular (app ntfy). Opcional pero muy recomendado.
# PANEL_ALERTA_URL=https://ntfy.sh/←

# Opcionales
# PANEL_PUERTO=3100                 # puerto local (solo 127.0.0.1)
# PANEL_PASO_TIMEOUT_MS=60000       # tiempo máximo de cada llamada a Supabase
# PANEL_MAX_PROYECTOS=40            # tope de proyectos en la organización (protege contra gastos por error)
# PANEL_ENCABEZADO_IP=              # dejalo vacío salvo que sepas qué encabezado pone tu proxy con la IP real
