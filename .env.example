VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Opcional: dirección (DSN) del proyecto de Sentry. Si queda vacía, no se envían errores.
VITE_SENTRY_DSN=
# Opcionales, solo para el build de producción (en el hosting, no en la PC): permiten
# subir a Sentry los mapas de código para que los errores se lean con el código
# original. SENTRY_AUTH_TOKEN es secreto. Sin las tres, el build funciona igual.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
