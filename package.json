{
  "name": "gestion-empresarial",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --ignore-pattern panel/dist --ignore-pattern panel/src/server/generado.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "cliente": "node scripts/cliente.mjs",
    "pruebas:integracion": "node scripts/pruebas/integracion.mjs",
    "pruebas:esquema": "node scripts/pruebas/esquema/esquema.mjs && node scripts/pruebas/esquema/esquema.mjs --componentes && node scripts/pruebas/esquema/equivalencia.mjs && node scripts/pruebas/esquema/actualizacion.mjs",
    "pruebas:supabase-local": "node scripts/pruebas/supabase-local/integracion-local.mjs && node scripts/pruebas/supabase-local/instalador-local.mjs && node scripts/pruebas/supabase-local/matriz-modulos.mjs && node scripts/pruebas/supabase-local/logica.mjs && node scripts/pruebas/supabase-local/matriz-permisos.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@sentry/react": "^11.4.0",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.52.0",
    "qrcode-generator": "^2.0.4",
    "radix-ui": "^1.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@sentry/vite-plugin": "^5.4.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@12.10.1"
}
